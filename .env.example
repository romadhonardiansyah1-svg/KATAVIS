# Salin menjadi .dev.vars untuk pengembangan lokal.
# .dev.vars diabaikan git. Untuk produksi gunakan `wrangler secret put <NAMA>`.
#
# JANGAN pernah mengisi berkas ini dengan nilai asli.

# --- ASR ---
# Groq: 28.800 detik audio/hari gratis, 20 permintaan/menit.
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Teks ---
# 9router untuk generate copywriting.
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=
# Model teks di proksi 9router. Bawaan ag/gemini-3.8-flash-high (terverifikasi
# Sep 2026 menjawab lewat proksi lokal dalam bentuk SSE).
NINEROUTER_TEXT_MODEL=ag/gemini-3.8-flash-high

# --- Auth ---
# Kunci penandatanganan JWT. Hasilkan dengan:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
JWT_SIGNING_KEY=

# Penyedia pengiriman OTP SMS.
OTP_PROVIDER_KEY=

# --- Studio Agent ---
# Rahasia bersama antara Worker dan Studio Agent di laptop.
# Dipakai pada header X-Agent-Key. Lihat docs/spec/API-CONTRACT.md bagian 8.
AGENT_SHARED_KEY=

# --- Alamat publik ---
# Alamat Worker ini dapat dijangkau dari luar. Dipakai oleh penyedia ASR di dalam
# konsumer antrian, yang tidak punya `Request` untuk menurunkan origin darinya.
# Lokal : http://localhost:8787
# Produksi: https://katavis.<subdomain>.workers.dev — tanpa garis miring di akhir.
PUBLIC_BASE_URL=

# --- Mode demo ---
# Menyajikan aset yang sudah di-cache bila jaringan gagal.
# Antarmuka menampilkan penanda saat aktif. Lihat ARCHITECTURE.md bagian 9.
DEMO_MODE=false

# --- Studio Agent, berkas .env terpisah di agent/ ---
# WORKER_URL=https://katavis.<subdomain>.workers.dev
# AGENT_ID=laptop-01
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_PROFILE_DIR=./agent/chrome-profile
# CHROME_DEBUG_PORT=9222
#
# PERINGATAN (ADR-004): gunakan akun Google TERPISAH, bukan akun utama.
# Sanksi ToS dapat mencakup penghapusan seluruh akun Google.
