{
  "name": "katavis",
  "version": "0.1.0",
  "private": true,
  "description": "Katalog digital untuk pengrajin difabel",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "dev:worker": "wrangler dev",
    "dev:agent": "node agent/index.js",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project worker",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test --grep @a11y",
    "test:mutation": "stryker run",
    "verify:contrast": "python tools/contrast.py",
    "verify:refs": "python tools/check_refs.py",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run verify:contrast && pnpm run verify:refs",
    "db:migrate:local": "wrangler d1 migrations apply katavis --local",
    "db:migrate:remote": "wrangler d1 migrations apply katavis --remote",
    "deploy:worker": "wrangler deploy",
    "apk:build": "bubblewrap build"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ulid": "3.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260916.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.2"
  }
}
