# Salin menjadi agent/.env lalu isi nilainya.
#
# agent/.env diabaikan git karena memuat AGENT_SHARED_KEY.
#
# ============================================================================
# PERINGATAN — BACA SEBELUM MENGISI
# ============================================================================
# Otomasi Gemini web melanggar Google Terms of Service bagian "Don't abuse our
# services" ("bypassing our systems or protective measures"). Sanksinya dapat
# mencakup penghapusan SELURUH akun Google — termasuk Gmail, Drive, dan Photos
# pada akun yang sama.
#
# WAJIB: gunakan akun Google TERPISAH yang tidak memuat data penting.
# Jangan pernah memakai akun utama anggota tim. ADR-004, RISK-REGISTER R-04.
#
# Tidak ada otomasi proses masuk di mana pun dalam kode agen. Login dilakukan
# manusia satu kali, dan tidak ada kredensial Google yang ditulis di berkas ini.
# ============================================================================

# Alamat Worker. Lokal saat pengembangan, workers.dev saat demo.
# Worker lokal berjalan di :8787 — lihat `pnpm run dev:worker`.
WORKER_URL=http://127.0.0.1:8787

# Nama agen. Muncul di agent_heartbeats dan di log Worker.
AGENT_ID=laptop-01

# Rahasia bersama dengan Worker. Nilainya HARUS sama dengan yang terpasang
# lewat `wrangler secret put AGENT_SHARED_KEY`. Dikirim pada header X-Agent-Key.
AGENT_SHARED_KEY=

# Jalur lengkap ke chrome.exe. Chrome ASLI, bukan Chromium bawaan Playwright:
# Chromium bawaan Playwright terbukti diblokir Google dengan pesan
# "This browser or app may not be secure".
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Direktori profil Chrome. Diabaikan git karena memuat sesi login Google.
# Jalankan agen sekali tanpa argumen untuk membuka jendela Chrome, masuk manual
# dengan akun Google TERPISAH, lalu jalankan lagi.
CHROME_PROFILE_DIR=./chrome-profile

# Port debug Chrome DevTools Protocol. Diubah hanya bila 9222 sudah dipakai.
CHROME_DEBUG_PORT=9222

# Halaman Gemini yang dipakai. Diubah hanya bila alamat berubah.
GEMINI_URL=https://gemini.google.com/app
